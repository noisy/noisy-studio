{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 14430,
            "statusMessage": "Listening for your voice (dev)",
            "asyncRewake": true,
            "rewakeSummary": "🎙️ Voice message received (dev)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 5,
            "statusMessage": "Reporting activity (dev)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 5,
            "statusMessage": "Reporting activity (dev)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 5,
            "statusMessage": "Checking voice queue (dev)"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 5,
            "statusMessage": "Reporting subagent (dev)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 5,
            "statusMessage": "Reporting subagent (dev)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOISY_STUDIO_LISTENER_PORT=7765 python3 \"$CLAUDE_PROJECT_DIR/hooks/claude_hook.py\"",
            "timeout": 14430,
            "statusMessage": "Listening for your voice (dev)",
            "asyncRewake": true,
            "rewakeSummary": "🎙️ Voice message received (dev)"
          }
        ]
      }
    ]
  }
}
