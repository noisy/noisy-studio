{
  "noisy-studio": {
    "command": "uv",
    "args": [
      "run",
      "--frozen",
      "--no-dev",
      "python",
      "hooks/codex_mcp.py"
    ],
    "startup_timeout_sec": 120,
    "tool_timeout_sec": 180,
    "cwd": ".",
    "env_vars": [
      "NOISY_STUDIO_CODEX_CONFIG",
      "NOISY_STUDIO_LISTENER_PORT"
    ]
  }
}
