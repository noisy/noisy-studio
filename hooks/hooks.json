{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 14430,
            "statusMessage": "Registering voice session",
            "asyncRewake": true,
            "rewakeSummary": "\ud83c\udf99\ufe0f Voice message received"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting activity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting activity"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting activity"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting subagent"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 14430,
            "statusMessage": "Reporting turn end",
            "asyncRewake": true,
            "rewakeSummary": "\ud83c\udf99\ufe0f Voice message received"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/native.sh\" hook",
            "timeout": 5,
            "statusMessage": "Reporting session end"
          }
        ]
      }
    ]
  }
}
